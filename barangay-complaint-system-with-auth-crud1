            "input": {
              "content": "# End-to-end functional test for the Barangay Complaint & Concern Reporting System\n# Run with:  powershell -ExecutionPolicy Bypass -File test-app.ps1\nparam([int]$Port = 8123)\n\n$ErrorActionPreference = 'Continue'\n$base = \"http://localhost:$Port\"\n$pass = 0; $fail = 0\n\nfunction Check {\n    param([string]$Label, [bool]$Ok, [string]$Detail = '')\n    if ($Ok) { $script:pass++; Write-Host (\"  PASS  \" + $Label) -ForegroundColor Green }\n    else     { $script:fail++; Write-Host (\"  FAIL  \" + $Label + \"  \" + $Detail) -ForegroundColor Red }\n}\n\nfunction Get-Page {\n    param([string]$Url, $Session)\n    try {\n        $r = Invoke-WebRequest -Uri $Url -UseBasicParsing -WebSession $Session -MaximumRedirection 0 -ErrorAction Stop\n        return [pscustomobject]@{ Status = [int]$r.StatusCode; Body = $r.Content; Headers = $r.Headers }\n    }\n    catch [System.Net.WebProtocolException] {\n        $resp = $_.Exception.Response\n        return [pscustomobject]@{ Status = [int]$resp.StatusCode; Body = ''; Headers = $resp.Headers }\n    }\n    catch {\n        return [pscustomobject]@{ Status = -1; Body = ''; Headers = $null; Error = $_.Exception.Message }\n    }\n}\n\nfunction Get-Csrf {\n    param([string]$Html)\n    if ($Html -match 'name=\"csrf_token\" value=\"([^\"]+)\"') { return $Matches[1] }\n    return ''\n}\n\nWrite-Host ''\nWrite-Host '=== 1. LANDING PAGE (public, no login) ===' -ForegroundColor Cyan\n\n$s = New-Object Microsoft.PowerShell.Commands.WebRequestSession\n$r = Get-Page \"$base/\" $s\nCheck 'GET / returns 200'            ($r.Status -eq 200) \"got $($r.Status)\"\nCheck 'Has business name'             ($r.Body -match 'Barangay San Isidro')\nCheck 'Has short description'        ($r.Body -match 'complaint and concern reporting system')\nCheck 'Has services section'         ($r.Body -match 'id=\"services\"')\nCheck 'Lists 8 report categories'    ((($r.Body | Select-String -Pattern 'service-card' -AllMatches).Matches.Count) -ge 8)\nCheck 'Has an <img> image'           ($r.Body -match '<img[^>]+hero-barangay\\.svg')\nCheck 'Has CTA: Register'            ($r.Body -match 'Create a free account')\nCheck 'Has CTA: Login'               ($r.Body -match 'I already have an account')\nCheck 'Has how-it-works section'     ($r.Body -match 'id=\"how-it-works\"')\nCheck 'Has FAQ section'              ($r.Body -match 'id=\"faq\"')\nCheck 'Loads CSS asset'              ($r.Body -match '/css/style\\.css')\nCheck 'Responsive viewport meta tag' ($r.Body -match 'name=\"viewport\"')\n\n$r = Get-Page \"$base/css/style.css\" $s\nCheck 'GET /css/style.css = 200 text/css' (($r.Status -eq 200) -and $r.Headers['Content-Type'] -match 'text/css') \"got $($r.Status)\"\n$r = Get-Page \"$base/img/hero-barangay.svg\" $s\nCheck 'GET hero image = 200 image/svg+xml' (($r.Status -eq 200) -and $r.Headers['Content-Type'] -match 'image/svg\\+xml') \"got $($r.Status)\"\n$r = Get-Page \"$base/js/app.js\" $s\nCheck 'GET /js/app.js = 200'         ($r.Status -eq 200) \"got $($r.Status)\"\n$r = Get-Page \"$base/health\" $s\nCheck 'GET /health = 200'            ($r.Status -eq 200) \"got $($r.Status)\"\n\nWrite-Host ''\nWrite-Host '=== 2. PROTECTED PAGES REDIRECT TO LOGIN ===' -ForegroundColor Cyan\nforeach ($p in @('/dashboard', '/complaints', '/complaints/new', '/profile', '/users')) {\n    $r = Get-Page \"$base$p\" $s\n    $loc = ''\n    if ($r.Headers -and $r.Headers['Location']) { $loc = $r.Headers['Location'] }\n    Check (\"$p redirects to login\") (($r.Status -eq 302) -and ($loc -match '^/login')) \"status=$($r.Status) loc=$loc\"\n}\n\nWrite-Host ''\nWrite-Host '=== 3. REGISTRATION + VALIDATION ===' -ForegroundColor Cyan\n\n$r = Get-Page \"$base/register\" $s\nCheck 'GET /register = 200'      ($r.Status -eq 200) \"got $($r.Status)\"\n$regCsrf = Get-Csrf $r.Body\nCheck 'Register form has CSRF token' ($regCsrf -ne '') \"empty\"\n\n# --- 3a. invalid input must produce friendly field errors -------------------\n$email = \"test.resident.$([guid]::NewGuid().ToString('N').Substring(0,6))@example.com\"\n$bad = @{\n    csrf_token = $regCsrf\n    name = 'A'\n    email = 'not-an-email'\n    phone = '12'\n    password = 'weak'\n    passwordConfirm = 'different'\n    agree = ''\n} \ntry {\n    $resp = Invoke-WebRequest -Uri \"$base/register\" -Method POST -Body $bad -WebSession $s -UseBasicParsing -ErrorAction Stop\n    $body = $resp.Content; $code = [int]$resp.StatusCode\n} catch { $body = $_.Exception.Response.GetResponseStream() | ForEach-Object { (New-Object IO.StreamReader($_)).ReadToEnd() }; $code = 400 }\nCheck 'Invalid registration rejected (200 re-render, not crash)' ($body -match 'Please fix the following')\nCheck 'Name too short error'    ($body -match 'at least 2 characters')\nCheck 'Invalid email error'     ($body -match 'valid email address')\nCheck 'Bad phone error'         ($body -match 'valid phone number')\nCheck 'Weak password error'     ($body -match 'at least 8 characters')\nCheck 'Consent required error'  ($body -match 'tick the confirmation box')\nCheck 'Field marked invalid'    ($body -match 'is-invalid')\n\n# --- 3b. valid registration ----------------------------------------------------\n$good = @{\n    csrf_token = $regCsrf\n    name = 'Test Resident'\n    email = $email\n    phone = '0917 555 1234'\n    address = 'Purok 7'\n    password = 'GoodPass@2026'\n    passwordConfirm = 'GoodPass@2026'\n    agree = 'yes'\n}\ntry {\n    $resp = Invoke-WebRequest -Uri \"$base/register\" -Method POST -Body $good -WebSession $s -UseBasicParsing -MaximumRedirection 0 -ErrorAction Stop\n    $code = [int]$resp.StatusCode; $loc = $resp.Headers['Location']\n} catch {\n    $resp = $_.Exception.Response; $code = [int]$resp.StatusCode; $loc = $resp.Headers['Location']\n}\nCheck 'Valid registration redirects to /dashboard' (($code -eq 302) -and ($loc -eq '/dashboard')) \"code=$code loc=$loc\"\n\n$r = Get-Page \"$base/dashboard\" $s\nCheck 'Auto signed in after register (no login needed)' ($r.Status -eq 200 -and $r.Body -match 'Test Resident') \"got $($r.Status)\"\n\n# --- 3c. duplicate email rejected ----------------------------------------------\n$r = Get-Page \"$base/logout\" $s\n$r2 = Get-Page \"$base/register\" $s\n$dup = @{\n    csrf_token = (Get-Csrf $r2.Body); name = 'Someone Else'; email = $email\n    password = 'GoodPass@2026'; passwordConfirm = 'GoodPass@2026'; agree = 'yes'\n}\ntry { $b = (Invoke-WebRequest -Uri \"$base/register\" -Method POST -Body $dup -WebSession $s -UseBasicParsing -ErrorAction Stop).Content }\ncatch { $b = $_.Exception.Response.GetResponseStream() | ForEach-Object { (New-Object IO.StreamReader($_)).ReadToEnd() } }\nCheck 'Duplicate email rejected' ($b -match 'already exists')\n\nWrite-Host ''\nWrite-Host '=== 4. LOGIN VALIDATION + CSRF ===' -ForegroundColor Cyan\n\n$r = Get-Page \"$base/login\" $s\n$loginCsrf = Get-Csrf $r.Body\nCheck 'GET /login = 200' ($r.Status -eq 200)\nCheck 'Login form has CSRF token' ($loginCsrf -ne '')\n\n$wrong = @{ csrf_token = $loginCsrf; email = 'nobody@example.com'; password = 'WrongPass@1' }\ntry { $b = (Invoke-WebRequest -Uri \"$base/login\" -Method POST -Body $wrong -WebSession $s -UseBasicParsing -ErrorAction Stop).Content }\ncatch { $b = $_.Exception.Response.GetResponseStream() | ForEach-Object { (New-Object IO.StreamReader($_)).ReadToEnd() } }\nCheck 'Unknown email rejected' ($b -match 'could not find an account')\n\n$wrongPw = @{ csrf_token = $loginCsrf; email = 'resident@barangay.gov.ph'; password = 'WrongPass@1' }\ntry { $b = (Invoke-WebRequest -Uri \"$base/login\" -Method POST -Body $wrongPw -WebSession $s -UseBasicParsing -ErrorAction Stop).Content }\ncatch { $b = $_.Exception.Response.GetResponseStream() | ForEach-Object { (New-Object IO.StreamReader($_)).ReadToEnd() } }\nCheck 'Wrong password rejected' ($b -match 'password you entered is incorrect')\n\n# CSRF-less POST must be refused\ntry { $b = (Invoke-WebRequest -Uri \"$base/login\" -Method POST -Body @{ email='resident@barangay.gov.ph'; password='Resident@12345' } -WebSession $s -UseBasicParsing -ErrorAction Stop).Content }\ncatch { $b = $_.Exception.Response.GetResponseStream() | ForEach-Object { (New-Object IO.StreamReader($_)).ReadToEnd() } }\nCheck 'Login without CSRF token refused' ($b -match 'form expired')\n\n# correct login\n$r = Get-Page \"$base/login\" $s\n$loginCsrf = Get-Csrf $r.Body\ntry {\n    $resp = Invoke-WebRequest -Uri \"$base/login\" -Method POST -WebSession $s -UseBasicParsing -MaximumRedirection 0 -Body @{ csrf_token=$loginCsrf; email='resident@barangay.gov.ph'; password='Resident@12345' } -ErrorAction Stop\n    $code = [int]$resp.StatusCode; $loc = $resp.Headers['Location']\n} catch { $resp = $_.Exception.Response; $code = [int]$resp.StatusCode; $loc = $resp.Headers['Location'] }\nCheck 'Correct login redirects to /dashboard' (($code -eq 302) -and ($loc -eq '/dashboard')) \"code=$code loc=$loc\"\n\n$r = Get-Page \"$base/dashboard\" $s\nCheck 'Resident dashboard loads' ($r.Status -eq 200 -and $r.Body -match 'Welcome back')\nCheck 'Dashboard shows Resident role pill' ($r.Body -match 'Resident')\nCheck 'Session cookie is HttpOnly' ($s.Cookies.GetCookies($base)['bcr_session'].HttpOnly)\n\nWrite-Host ''\nWrite-Host '=== 5. RESIDENT: OWN-DATA ISOLATION ===' -ForegroundColor Cyan\n$r = Get-Page \"$base/complaints\" $s\nCheck 'Resident list page = 200' ($r.Status -eq 200)\nCheck 'Header says \"My reports\"' ($r.Body -match 'My reports')\nCheck 'Sees own report BC R-2026-0001' ($r.Body -match 'BCR-2026-0001')\nCheck 'Cannot see admin-only Residents nav' (-not ($r.Body -match '>Residents<'))\n\n$r = Get-Page \"$base/users\" $s\nCheck 'Resident blocked from /users (403)' ($r.Status -eq 403) \"got $($r.Status)\"\nCheck '403 page explains admin-only' ($r.Body -match 'Administrator access only')\n\nWrite-Host ''\nWrite-Host '=== 6. CRUD: CREATE ===' -ForegroundColor Cyan\n$r = Get-Page \"$base/complaints/new\" $s\nCheck 'GET /complaints/new = 200' ($r.Status -eq 200)\n$csrf = Get-Csrf $r.Body\n\n# validation first\n$invalid = @{ csrf_token=$csrf; title='ab'; category='Nope'; priority='Critical'; location='x'; description='too short' }\ntry { $b = (Invoke-WebRequest -Uri \"$base/complaints/new\" -Method POST -Body $invalid -WebSession $s -UseBasicParsing -ErrorAction Stop).Content }\ncatch { $b = $_.Exception.Response.GetResponseStream() | ForEach-Object { (New-Object IO.StreamReader($_)).ReadToEnd() } }\nCheck 'Invalid complaint rejected'        ($b -match 'Please fix the following')\nCheck 'Title minimum enforced'           ($b -match 'at least 5 characters')\nCheck 'Category must be whitelisted'     ($b -match 'choose a category from the list')\nCheck 'Priority must be whitelisted'     ($b -match 'choose a priority from the list')\nCheck 'Description minimum enforced'     ($b -match 'at least 20 characters')\n\n$title = 'Broken water pump near Purok 3 ' + ([guid]::NewGuid().ToString('N').Substring(0,4))\n$valid = @{\n    csrf_token = $csrf\n    title = $title\n    category = 'Water & Sanitation'\n    priority = 'High'\n    location = 'Purok 3, near the basketball court'\n    description = 'The water pump serving Purok 3 has not been working for three days. Households have no clean water supply.'\n}\ntry {\n    $resp = Invoke-WebRequest -Uri \"$base/complaints/new\" -Method POST -Body $valid -WebSession $s -UseBasicParsing -MaximumRedirection 0 -ErrorAction Stop\n    $code = [int]$resp.StatusCode\n} catch { $code = [int]$_.Exception.Response.StatusCode }\nCheck 'Valid complaint created (302)' ($code -eq 302) \"code=$code\"\n\n$r = Get-Page \"$base/complaints\" $s\nCheck 'New complaint appears in list' ($r.Body -match [regex]::Escape($title))\nCheck 'Assigned a reference number'   ($r.Body -match 'BCR-\\d{4}-\\d{4}')\nCheck 'Starts with status Pending'    ($r.Body -match '>Pending<')\n\n# find its id\n$r = Get-Page \"$base/complaints?q=$([uri]::EscapeDataString('Broken water pump'))\" $s\n$id = ''\nif ($r.Body -match '/complaints/(cmp_[A-Za-z0-9\\-_]+)\"') { $id = $Matches[1] }\nCheck 'Located the new complaint id' ($id -ne '') \"id=$id\"\n\nWrite-Host ''\nWrite-Host '=== 7. CRUD: READ (detail page) ===' -ForegroundColor Cyan\n$r = Get-Page \"$base/complaints/$id\" $s\nCheck 'Detail page = 200'            ($r.Status -eq 200) \"got $($r.Status)\"\nCheck 'Shows title'                  ($r.Body -match [regex]::Escape($title))\nCheck 'Shows category'               ($r.Body -match 'Water &amp; Sanitation|Water & Sanitation')\nCheck 'Shows reference number'       ($r.Body -match 'BCR-\\d{4}-\\d{4}')\nCheck 'Shows reporter'               ($r.Body -match 'Test Resident')\nCheck 'Has progress timeline'        ($r.Body -match 'class=\"steps\"')\nCheck 'Resident sees NO admin status panel' (-not ($r.Body -match 'Update status'))\n\n$r = Get-Page \"$base/complaints/cmp_doesnotexist\" $s\nCheck 'Unknown complaint id = 404'   ($r.Status -eq 404) \"got $($r.Status)\"\n\nWrite-Host ''\nWrite-Host '=== 8. CRUD: UPDATE ===' -ForegroundColor Cyan\n$r = Get-Page \"$base/complaints/$id/edit\" $s\nCheck 'Edit form = 200' ($r.Status -eq 200)\n$csrf = Get-Csrf $r.Body\nCheck 'Edit form pre-filled with title' ($r.Body -match [regex]::Escape($title))\n\n$newTitle = 'Broken water pump - URGENT follow up'\ntry {\n    $resp = Invoke-WebRequest -Uri \"$base/complaints/$id/edit\" -Method POST -WebSession $s -UseBasicParsing -Body @{\n        csrf_token=$csrf; title=$newTitle; category='Water & Sanitation'; priority='Urgent'\n        location='Purok 3, near the basketball court'\n        description='The water pump serving Purok 3 has not been working for three days. Households have no clean water supply.'\n    } -ErrorAction Stop\n    $b = $resp.Content\n} catch { $b = $_.Exception.Response.GetResponseStream() | ForEach-Object { (New-Object IO.StreamReader($_)).ReadToEnd() } }\nCheck 'Update succeeded (title changed)' ($b -match [regex]::Escape($newTitle))\nCheck 'Update changed priority to Urgent' ($b -match 'Urgent')\n\n# re